    "dist",
    "index.d.ts",
    "src/index.d.ts",
    "src/tailmantics/index.js",
    "src/*/*.d.ts",
    "src/*/*.styles.js",
    "src/tokens",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "test": "npm run build && node --test test/popper.test.js test/overlays.test.js test/interactions.test.js test/exports.test.js test/pack-consumer.test.js test/ssr.test.js",
    "typecheck": "tsc --noEmit --strict --jsx react-jsx --module ESNext --moduleResolution Bundler --target ES2022 index.d.ts src/index.d.ts src/type-tests/public-api.tsx src/type-tests/all-components.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "peerDependencies": {
    "@popperjs/core": "^2.11.8",
    "react": ">=18",
    "react-dom": ">=18",
    "tailmantic": "^1.0.0"
